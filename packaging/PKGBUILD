# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
#
# Arch package for couchcord. Same payload as the Fedora RPM
# (packaging/couchcord.spec); all paths are identical across both distros.
# Usable directly with makepkg from this directory after a release tag is
# pushed, or published to the AUR (regenerate .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO` on every change).

pkgname=couchcord
pkgver=0.1.0
pkgrel=1
pkgdesc="Controller-driven Discord voice control + activity overlay for gamescope game mode"
arch=('x86_64')
url="https://github.com/MasonRhodesDev/couchcord"
license=('MIT')
install="$pkgname.install"
depends=('gcc-libs' 'systemd')
makedepends=('cargo')
optdepends=(
  'discord: the client the daemon controls over local RPC'
  'gamescope: game-mode session providing the external-overlay atom'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # pin on release: updpkgsums

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/couchcordd "$pkgdir/usr/bin/couchcordd"
  install -Dm644 dist/couchcordd.service "$pkgdir/usr/lib/systemd/user/couchcordd.service"
  install -Dm644 config.toml.example "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/SETUP.md "$pkgdir/usr/share/doc/$pkgname/SETUP.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
