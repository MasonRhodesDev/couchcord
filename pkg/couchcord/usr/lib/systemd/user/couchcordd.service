[Unit]
Description=couchcord — Discord voice control + activity overlay for game mode
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/deck-pkgs/usr/bin/couchcordd run
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=couchcordd=info,cc_discord=info

[Install]
WantedBy=graphical-session.target
