#!/bin/bash
# Multi-tenant Discord launcher for shared devices (Steam Deck / HTPC).
#
# Preferred path: delegate to deck-tenant (per-Steam-account virtual homes,
# https://github.com/MasonRhodesDev/deck-tenant) when Discord is registered
# there. Fallback: the original per-app symlink swap, so this launcher keeps
# working standalone.
set -u

FLATPAK_ID="com.discordapp.Discord"

# --- preferred: deck-tenant virtual homes ---
if command -v deck-tenant >/dev/null 2>&1 \
   && grep -q "^$FLATPAK_ID	" "${XDG_CONFIG_HOME:-$HOME/.config}/deck-tenant/apps.tsv" 2>/dev/null; then
    wrapper=$(grep "^$FLATPAK_ID	" "${XDG_CONFIG_HOME:-$HOME/.config}/deck-tenant/apps.tsv" | cut -f3)
    [ -x "$wrapper" ] && exec "$wrapper" "$@"
fi

# --- fallback: per-app config symlink swap in the real home ---
uid=$(python3 - <<'PY' 2>/dev/null
import os, re
p = os.path.expanduser('~/.steam/steam/config/loginusers.vdf')
try:
    d = open(p, encoding='utf-8', errors='replace').read()
except OSError:
    raise SystemExit
for m in re.finditer(r'"(\d{17})"\s*\{(.*?)\}', d, re.S):
    if re.search(r'"MostRecent"\s*"1"', m.group(2)):
        print(int(m.group(1)) - 76561197960265728)
        break
PY
)
[ -z "${uid:-}" ] && uid=default

appdir="$HOME/.var/app/$FLATPAK_ID"
profiles="$appdir/discord-profiles"
mkdir -p "$profiles/$uid" "$appdir/config"

marker="$profiles/.active-tenant"
if [ -f "$marker" ] && [ "$(cat "$marker" 2>/dev/null)" != "$uid" ]; then
    if flatpak ps --columns=application 2>/dev/null | grep -qx "$FLATPAK_ID"; then
        flatpak kill "$FLATPAK_ID" 2>/dev/null
        for _ in $(seq 1 20); do
            flatpak ps --columns=application 2>/dev/null | grep -qx "$FLATPAK_ID" || break
            sleep 0.5
        done
    fi
fi
printf '%s\n' "$uid" > "$marker"

cur="$appdir/config/discord"
if [ -e "$cur" ] && [ ! -L "$cur" ] && [ ! -e "$profiles/default" ]; then
    mv "$cur" "$profiles/default"   # keep any pre-existing login as the fallback profile
fi
[ -e "$cur" ] && [ ! -L "$cur" ] && rm -rf "$cur"
ln -sfn "$profiles/$uid" "$cur"

flags=()
if [ -f "$HOME/.config/discord-flags.conf" ]; then
    mapfile -t flags < <(grep -v '^\s*#' "$HOME/.config/discord-flags.conf" | grep -v '^\s*$')
fi
exec flatpak run "$FLATPAK_ID" "${flags[@]}" "$@"
